# general file excludes
~*.tmp
*~
~$*

# ignore Xilinx ISE files
/tests/ISE/**/*.*
!/tests/ISE/*.xise
!/tests/ISE/iseconfig/filter.filter

# ignore Xilinx Vivado files
/tests/Vivado/**/*.*
!/tests/Vivado/**/*.xpr

# ignore QuestaSim files
/tests/QuestaSim/*
/tests/QuestaSim/**/*.*
!/tests/QuestaSim/*.cmd
!/tests/QuestaSim/*.log

# ignore GHDL files
/tests/ghdl/**/*.*
!/tests/ghdl/*.cmd
!/tests/ghdl/*.log

# ignore NVC files
/tests/nvc/**/*.*
!/tests/nvc/*.cmd
!/tests/nvc/*.log

# Sigasi files
/.sigasi/**/*.*
!/.sigasi/project.sigasi

# general whitelist
!.git*

*.cf
JSONTestSuite/config.pkg.vhdl
